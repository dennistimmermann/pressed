{
  "elements": [
    "div", "span", "img", "br",
    "p", "h1", "h2", "h3", "h4", "h5", "h6",
    "b", "strong", "em", "i", "u", "small"
  ],
  "svgElements": [
    "svg", "path", "rect", "g", "circle", "line", "polyline", "polygon", "text"
  ],
  "properties": {
    "display": ["flex", "grid", "block", "inline", "none"],
    "flex-direction": true,
    "justify-content": true,
    "align-items": true,
    "align-self": true,
    "flex-wrap": true,
    "flex": true,
    "flex-grow": true,
    "flex-shrink": true,
    "flex-basis": true,
    "gap": true,
    "row-gap": true,
    "column-gap": true,
    "order": true,
    "grid-template-columns": true,
    "grid-template-rows": true,
    "grid-template-areas": true,
    "grid-column": true,
    "grid-row": true,
    "grid-area": true,
    "position": ["relative", "absolute"],
    "top": true,
    "right": true,
    "bottom": true,
    "left": true,
    "overflow": ["visible", "hidden"],
    "box-sizing": true,
    "width": true,
    "height": true,
    "min-width": true,
    "max-width": true,
    "min-height": true,
    "max-height": true,
    "aspect-ratio": true,
    "padding": true,
    "padding-top": true,
    "padding-right": true,
    "padding-bottom": true,
    "padding-left": true,
    "margin": true,
    "margin-top": true,
    "margin-right": true,
    "margin-bottom": true,
    "margin-left": true,
    "border": true,
    "border-width": true,
    "border-style": ["solid", "dashed", "dotted", "none"],
    "border-color": true,
    "border-top": true,
    "border-right": true,
    "border-bottom": true,
    "border-left": true,
    "border-radius": true,
    "border-top-left-radius": true,
    "border-top-right-radius": true,
    "border-bottom-right-radius": true,
    "border-bottom-left-radius": true,
    "font-family": true,
    "font-size": true,
    "font-weight": true,
    "font-style": true,
    "line-height": true,
    "letter-spacing": true,
    "text-align": true,
    "text-transform": true,
    "text-decoration": ["underline", "line-through", "none"],
    "white-space": true,
    "overflow-wrap": true,
    "word-break": true,
    "text-overflow": true,
    "line-clamp": true,
    "color": true,
    "background": true,
    "background-color": true,
    "background-image": true,
    "background-size": true,
    "background-position": true,
    "background-repeat": true,
    "opacity": true,
    "transform": true,
    "transform-origin": true,
    "--*": true
  },
  "chromeOnly": ["text-overflow", "line-clamp"],
  "transformFunctions": ["rotate", "translate", "translateX", "translateY", "scale", "scaleX", "scaleY"],
  "units": ["mm", "pt", "px", "em", "%", "deg", "rem", "vw", "vh", "vmin", "vmax"],
  "functions": ["calc", "var", "linear-gradient", "radial-gradient", "url"],
  "urlPrefixes": ["asset:", "data:"],
  "selectors": {
    "combinators": [" ", ">", "+", "~"],
    "pseudoClasses": ["first-child", "last-child", "nth-child"]
  },
  "atRules": ["font-face"]
}
