{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "w3c-web-usb"],
    "jsx": "preserve",
    "paths": {
      "@/*": ["./src/*"],
      "pressed": ["../../packages/core/src/template/pressed-module.ts"]
    }
  },
  "include": ["src", "vite.config.ts"],
  // src/templates/*.vue are bundled example *sources*, read with ?raw — never app components.
  "exclude": ["src/templates"]
}
